{
  "name": "@qarar/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @qarar/theme build && pnpm --filter @qarar/react-builder build && pnpm --filter @qarar/sdk build",
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "start": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "lint": "biome lint .",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/react": "^4.2.1",
    "@astrojs/starlight": "^0.32.1",
    "@qarar/compiler-mongo": "workspace:*",
    "@qarar/compiler-sql": "workspace:*",
    "@qarar/engine-js": "workspace:*",
    "@qarar/react-builder": "workspace:*",
    "@qarar/sdk": "workspace:*",
    "@qarar/spec": "workspace:*",
    "@qarar/theme": "workspace:*",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "astro": "^5.4.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2"
  }
}
