{
  "name": "@qarar/playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @qarar/theme build && pnpm --filter @qarar/react-builder build && pnpm --filter @qarar/sdk build",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint ."
  },
  "dependencies": {
    "@qarar/compiler-mongo": "workspace:*",
    "@qarar/compiler-sql": "workspace:*",
    "@qarar/engine-js": "workspace:*",
    "@qarar/react-builder": "workspace:*",
    "@qarar/sdk": "workspace:*",
    "@qarar/spec": "workspace:*",
    "@qarar/theme": "workspace:*",
    "@radix-ui/react-collapsible": "^1.1.13",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-separator": "^1.1.9",
    "@radix-ui/react-tabs": "^1.1.14",
    "@radix-ui/react-tooltip": "^1.2.9",
    "@tailwindcss/vite": "^4.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.6"
  }
}
