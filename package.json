{
  "name": "qarar",
  "private": true,
  "version": "0.0.4",
  "packageManager": "pnpm@9.1.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "bench": "pnpm --filter @qarar/benchmark bench",
    "bench:dataset": "pnpm --filter @qarar/benchmark bench:dataset",
    "bench:micro": "pnpm --filter @qarar/benchmark bench:micro",
    "bench:decision": "pnpm --filter @qarar/benchmark bench:decision",
    "lint": "turbo run lint",
    "lint:all": "biome lint .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "version:bump": "node scripts/bump-version.mjs",
    "release:check": "turbo run lint typecheck test build",
    "publish:sdk:check": "pnpm --filter @qarar/sdk build && pnpm --filter @qarar/sdk test",
    "smoke:sdk:published": "cd examples/published-test-app && rm -rf node_modules package-lock.json && npm install && npm start",
    "publish:sdk": "pnpm run publish:sdk:check && pnpm --filter @qarar/sdk publish --access public && pnpm run smoke:sdk:published"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
