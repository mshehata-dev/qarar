{
  "name": "@qarar/sdk",
  "version": "0.0.4",
  "description": "Zero-dependency single-package Qarar SDK — portable AST, 6M ops/sec engine, SQL/Mongo pushdown & explainability",
  "keywords": [
    "rules-engine",
    "business-rules",
    "decision-engine",
    "zero-dependencies",
    "ast",
    "sql-pushdown",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./spec": {
      "import": "./dist/spec.js",
      "types": "./dist/spec.d.ts"
    },
    "./engine": {
      "import": "./dist/engine.js",
      "types": "./dist/engine.d.ts"
    },
    "./explainability": {
      "import": "./dist/explainability.js",
      "types": "./dist/explainability.d.ts"
    },
    "./builder": {
      "import": "./dist/builder.js",
      "types": "./dist/builder.d.ts"
    },
    "./sql": {
      "import": "./dist/sql.js",
      "types": "./dist/sql.d.ts"
    },
    "./mongo": {
      "import": "./dist/mongo.js",
      "types": "./dist/mongo.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "biome lint .",
    "prepublishOnly": "pnpm run build && pnpm run test"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {},
  "devDependencies": {
    "@qarar/compiler-mongo": "workspace:*",
    "@qarar/compiler-sql": "workspace:*",
    "@qarar/engine-js": "workspace:*",
    "@qarar/explainability": "workspace:*",
    "@qarar/spec": "workspace:*",
    "tsup": "^9.0.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
